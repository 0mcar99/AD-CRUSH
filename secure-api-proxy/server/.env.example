# =========================================================================
# SECURE SERVER-SIDE ENVIRONMENT CONFIGURATION (.env)
# =========================================================================
# WARNING: NEVER check this file (with actual secrets) into source control.
# Add .env to your server-side .gitignore file.
# Under no circumstances should these variables be prefixed with "NEXT_PUBLIC_"
# or "VITE_" because those prefixes force builders to compile them into client JS!
# =========================================================================

# The environment mode (e.g., development, production)
NODE_ENV=development

# Port where your local backend proxy server will run
PORT=5000

# Strict CORS: Comma-separated list of fully-qualified client domain origins
# only these domains will be permitted to access this proxy server.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Sensitive Third-Party API Key (Isolate strictly on the server)
# The browser will never see, request, or download this secret.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
